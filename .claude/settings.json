{
  "permissions": {
    "allow": [
      "Bash(./gradlew *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git mv *)",
      "Bash(git rm *)",
      "Bash(git stash *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr list *)",
      "Bash(gh run *)",
      "Bash(gh issue *)",
      "Bash(gh api *)",
      "Bash(tson-cli/build/install/tson/bin/tson *)",
      "Bash(scripts/restamp-bundled-schemas.sh --check)",
      "Bash(scripts/check-line-length.sh *)",
      "WebFetch(domain:tson.io)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebSearch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/line-length-before-commit.sh"
          }
        ]
      }
    ]
  }
}
