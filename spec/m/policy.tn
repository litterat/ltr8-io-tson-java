!!id:"https://tson.io/2026/40/m/policy.tn?sha256=a236c4fdbc85611a5c2c1e198ef809a49ff90854428d2992c54fa03d2cc5c3b7"
!!import:"https://tson.io/2026/40/m/meta.tn?sha256=fba10509f9c9db688ee01d2921635a24b1879d80b19f43c59edba3674c18252d"
@doc:"""
  The TSON processor policy: what a processor admits as a name and what it
  spends ([TSON-DATA] §8.2, §9.1; [TSON-SCHEMA] §11.5). A policy is the
  deployment's, never a schema's: no document names, imports or selects the
  policy it is judged under. A deployment that writes its policy down writes a
  data document of type `policy.processor`. A script is named by its Unicode
  Script property value alias (UAX #24), `Latin`, `Cyrillic`, `Han`.
  """
!schema {
  policy => !schema {
    @doc:"UTS #39 §5.2's restriction levels, strictest first."
    restriction_level => !enum [
      ASCII_ONLY SINGLE_SCRIPT HIGHLY_RESTRICTIVE MODERATELY_RESTRICTIVE MINIMALLY_RESTRICTIVE UNRESTRICTED
    ]

    @doc:"""
      The token policy: the level over each whole token. Each entry of
      `permitting` is a script combination admitted over the level (UTS #39
      §5.2).
      """
    script_policy => { level: policy.restriction_level  permitting: [[text]] }

    @doc:"""
      The identifier policy. `per_segment` applies the level to each segment of
      a name rather than to the whole of it, and `skeleton_distinctness` forbids
      two names in one scope sharing a UTS #39 skeleton.
      """
    identifier_policy => {
      level: policy.restriction_level
      per_segment: boolean
      skeleton_distinctness: boolean
      permitting: [[text]]
    }

    @doc:"""
      One resource limit: a count, a depth or a size. A processor that holds a
      limit in a narrower type caps a larger value at the widest it holds.
      """
    limit => !int64 ^ { min: 1 }

    @doc:"""
      What a processor will spend reading one document and resolving one schema.
      Each default is the specification's value, and a deployment writes only
      what it raises. A limit refusal names the limit and the threshold, and is
      not a verdict on the document ([TSON-DATA] §9.1, [TSON-SCHEMA] §11.5).
      """
    limits => {
      max_depth?:                  policy.limit ~ 64
      max_token_length?:           policy.limit ~ 1048576
      max_text_length?:            policy.limit ~ 1048576
      max_numeric_literal_length?: policy.limit ~ 4096
      max_binary_size?:            policy.limit ~ 16777216
      max_document_size?:          policy.limit ~ 16777216
      max_elements?:               policy.limit ~ 1048576
      max_entries?:                policy.limit ~ 1048576
      max_fields?:                 policy.limit ~ 65536
      max_annotations?:            policy.limit ~ 64
      max_values?:                 policy.limit ~ 16777216
      max_import_closure?:         policy.limit ~ 64
      max_schema_entries?:         policy.limit ~ 65536
      max_alias_chain?:            policy.limit ~ 64
      max_supertype_chain?:        policy.limit ~ 64
      max_wait_depth?:             policy.limit ~ 64
    }

    @doc:"""
      The policy a processor judges a document under. `unicode_data_version` is
      the UCD release whose tables the name rules read: a report states it, and
      a deployment's own policy document leaves it out.
      """
    processor => {
      identifier_policy: policy.identifier_policy
      token_policy: policy.script_policy
      unicode_data_version?: text
      limits: policy.limits
    }
  }
}
