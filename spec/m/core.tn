!!id:"https://tson.io/2026/40/m/core.tn?sha256=1d57dbba4a89ee2649a1cc32446d27bfeb33ba722b684a1a0bac84b46a835472"
!!import:"https://tson.io/2026/40/m/numeric.tn?sha256=44b6423f588662106c5cc68f398e3ea2f0734196e80defb928a4b218d4cb83a8"
!!import:"https://tson.io/2026/40/m/temporal.tn?sha256=e839a87b7e98ca1185a4a9fb2f364e770603a0f4f60cc4b4e26faa4cc02759b8"
!!import:"https://tson.io/2026/40/m/net.tn?sha256=a7ecf6cc57c1e04836ab319e2f2d882b6f5a5fcb826e7c30931a6e3bf83a5761"
@doc:"""
  TSON core: every bundled type in one import. It imports numeric.tn,
  temporal.tn and net.tn, and declares the author annotations, none of which
  changes what a type admits ([TSON-SCHEMA] §6, §9).
  """
!schema {
  @doc:"""
    Marks a definition or field as deprecated, written bare before it:
    `@deprecated`.
    """
  deprecated => @meta.annotation void

  @doc:"A short human-readable name for a definition or field."
  title => @meta.annotation text

  @doc:"""
    A note for a schema's maintainers, which a documentation tool leaves out.
    """
  comment => @meta.annotation text

  @doc:"""
    Example values for a definition or field. Each is the text a reader is
    shown, conventionally the value in TSON notation, and nothing parses or
    checks one.
    """
  examples => @meta.annotation [text]

  @doc:"Marks a field a consumer may read but not write."
  read_only => @meta.annotation void

  @doc:"Marks a field a consumer may write but not read."
  write_only => @meta.annotation void
}
