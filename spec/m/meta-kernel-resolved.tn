  set_type => !type_definition {
    source: array
    supertypes: [array product top]
    body: !record { fields: [
      !record_field { name: access_pattern  type: product_access_type  optional: true  role: FIXED  value: INDEX }
      !record_field { name: size_type       type: product_size_type    optional: true  role: FIXED  value: VARIABLE }
      !record_field { name: element_type    type: type_ref }
      !record_field { name: state           type: element_state  optional: true  role: FIXED  value: REQUIRED }
      !record_field { name: ordered         type: boolean  optional: true  role: FIXED  value: false }
      !record_field { name: unique_items    type: boolean  optional: true  role: FIXED  value: true }
