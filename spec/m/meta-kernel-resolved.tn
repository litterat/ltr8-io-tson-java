  scheme_set => !type_definition {
    source: set_type
    body: !set_type { element_type: scheme_name  min_items: 1 }
  }

  scheme_name => !type_definition {
    source: identifier_type
    body: !identifier_type { start: ASCII  continue: ASCII  continue_add: "+-."  exclude: "_"  normalization: ASCII_CASEFOLD }
  }

  iri => !type_definition {
    source: iri_type
    body: !iri_type { allow_relative: false }
  }

  regex_type => !type_definition {
    supertypes: [atom atom_specification text_type top type]
    body: !record { supertypes: [text_type atom_specification]  fields: {
      min_length    => !record_field { type: non_negative_integer  optional: true }
      max_length    => !record_field { type: non_negative_integer  optional: true }
      length        => !record_field { type: non_negative_integer  optional: true }
      pattern       => !record_field { type: regex  optional: true }
      members       => !record_field { type: text_member_set  optional: true }
      normalization => !record_field { type: normalization  optional: true  role: FIXED  value: NONE }
      spec          => !record_field { type: iri  optional: true  role: FIXED  value: "https://www.rfc-editor.org/rfc/rfc9485" }
    } }
  }

  regex => !type_definition {
    source: regex_type
    body: !regex_type {}
  }

  type_name => !type_definition {
    source: identifier
    body: !reference { target: identifier }
  }

  field_name => !type_definition {
    source: identifier
    body: !reference { target: identifier }
  }

  param_name => !type_definition {
    source: identifier
    body: !reference { target: identifier }
  }

  type_ref => !type_definition {
    body: !record { fields: {
      name      => !record_field { type: type_name }
      arguments => !record_field { type: array_type_argument_xxhash  optional: true }
    } }
  }

  type_argument => !type_definition {
    body: !record { fields: {
      name  => !record_field { type: type_ref  optional: true }
      value => !record_field { type: value  optional: true }
    }
