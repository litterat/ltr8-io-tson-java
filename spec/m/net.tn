!!id:"https://tson.io/2026/40/m/net.tn?sha256=30a36db1b57b61c871b5763eace80ff1b2fa19c5ae2c3c58776295abc2f4e38d"
!!import:"https://tson.io/2026/40/m/meta.tn?sha256=ee2394b1554c4ea15cee5441b1622f8ddee19c171a7425b07aeab63da9fafc0a"
@doc:"""
  The TSON network library: `email`, `ipv4`, `ipv6`, `cidr4`, `cidr6`, `mac`,
  `hostname`, `host`, `media_type`, `uri`, `uri_reference` and `uuid`. A schema
  imports it, or core.tn, to write them ([TSON-DATA] §5.5, [TSON-SCHEMA] §5.5).
  """
!schema {
  @doc:"The network constructors, each named by its path, `net.ipv4_type`."
  net => !schema {
    @doc:"""
      The constructor of `email` (RFC 5322). An address is its text as written.
      """
    email_type => unicode.text_type & atom.specification & {
      spec?:          = "https://www.rfc-editor.org/rfc/rfc5322"
      normalization?: = NONE
    }

    @doc:"""
      The constructor of `ipv4`: RFC 3986's `IPv4address`, a dotted quad. An
      address lies inside at least one `within` network, where any is given, and
      inside no `excluding` network:
      `private => !ipv4 ^ { within: ["10.0.0.0/8"] }`.
      """
    ipv4_type => meta.atom & atom.specification & {
      spec?:      = "https://www.rfc-editor.org/rfc/rfc3986"
      within?:    [cidr4]
      excluding?: [cidr4]
    }

    @doc:"""
      The constructor of `ipv6`: RFC 4291 §2.2 text, with no zone identifier.
      `within` and `excluding` are as `ipv4_type`'s.
      """
    ipv6_type => meta.atom & atom.specification & {
      spec?:      = "https://www.rfc-editor.org/rfc/rfc4291"
      within?:    [cidr6]
      excluding?: [cidr6]
    }

    @doc:"""
      The constructor of `cidr4`: an address, `/` and a prefix length.
      `min_prefix` and `max_prefix` lie in 0-32. A value is a subnet of at least
      one `within` network, where any is given, and overlaps no `excluding`
      network. Ordering is by containment, and disjoint networks are
      incomparable.
      """
    cidr4_type => meta.atom & atom.specification & {
      spec?:       = "https://www.rfc-editor.org/rfc/rfc4632"
      min_prefix?: numeric.count
      max_prefix?: numeric.count
      within?:     [cidr4]
      excluding?:  [cidr4]
    }

    @doc:"""
      The constructor of `cidr6`: as `cidr4_type`, with prefix lengths in 0-128.
      """
    cidr6_type => meta.atom & atom.specification & {
      spec?:       = "https://www.rfc-editor.org/rfc/rfc4291"
      min_prefix?: numeric.count
      max_prefix?: numeric.count
      within?:     [cidr6]
      excluding?:  [cidr6]
    }

    @doc:"""
      The constructor of `mac`. EUI-48: six hex octets, colon- or
      hyphen-separated.
      """
    mac_type => meta.atom & atom.specification & {
      spec?: = "https://www.rfc-editor.org/rfc/rfc9542"
    }

    @doc:"""
      The constructor of `hostname`. A domain name: labels of ASCII letters,
      digits and hyphens (RFC 1123 §2.1), or internationalized labels judged by
      IDNA2008 (RFC 5890 to RFC 5893), written as U-labels or as their A-labels,
      in any mix. `A`-`Z` read as `a`-`z`; nothing else is mapped, so uppercase
      beyond ASCII, a U-label not in NFC and percent-encoding are not host
      names. A label is at most 63 octets and the name at most 253, counted in
      the A-label form; no label is empty, none begins or ends with `-`, and
      there is no trailing `.`. The last label does not begin with a digit.

      The value is the name: every spelling of one name is one value, and its
      canonical text has each internationalized label as its U-label.
      `allow_idn` false admits only names with no internationalized label, in
      either spelling.
      """
    hostname_type => meta.atom & atom.specification & {
      spec?:      = "https://www.rfc-editor.org/rfc/rfc5890"
      allow_idn?: boolean ~ true
    }

    @doc:"""
      The constructor of `host`. RFC 3987's `ihost` with a DNS name: a host name
      as `hostname_type` has it, an IPv4 address in dotted-quad, or an IPv6
      address, with or without the brackets a URI puts around one, and no zone
      identifier.

      The value is the name or the address, never both: a name compares by name,
      an address by its octets, and an IPv4 address never equals an IPv6 one,
      IPv4-mapped included. The canonical text is the member's: the name's
      U-labels, the dotted-quad, or RFC 5952 text without brackets.
      """
    host_type => meta.atom & atom.specification & {
      spec?: = "https://www.rfc-editor.org/rfc/rfc3987"
    }

    @doc:"""
      The constructor of `media_type`. A media type (RFC 6838) and its
      parameters (RFC 9110 §8.3.1): the type and subtype are RFC 6838 §4.2's
      `restricted-name`, and each parameter is a token name, `=` and a token or
      quoted-string value, after a `;` with optional whitespace around it.
      Nothing beyond US-ASCII. A media range (`text/*`) is not a media type.

      The value is the type, the subtype and a map of parameters: the type,
      subtype and parameter names compare without ASCII case, a quoted value
      equals its token form, parameter order carries no meaning and a repeated
      name is a resolver error, and a parameter value keeps its case except
      `charset`'s, which folds. The canonical text is lowercase, with `charset`
      folded and parameters sorted by name, each value a token where it is one,
      joined by `;` without whitespace.

      Parameters are admitted only where `allow_parameters` is set, as in
      `content_type => !net.media_type_type { allow_parameters: true }`. `types`
      lists the top-level types admitted. `suffixes` lists RFC 6839 structured
      suffixes: a suffix admits a subtype ending `+` and the suffix, and the
      subtype that is the suffix itself.
      """
    media_type_type => meta.atom & atom.specification & {
      spec?:             = "https://www.rfc-editor.org/rfc/rfc6838"
      allow_parameters?: boolean ~ false
      types?:            [text]
      suffixes?:         [text]
    }

    @doc:"""
      The constructor of `uri` and `uri_reference`: RFC 3986's grammar,
      US-ASCII, with `net.iri_type`'s facets. Withdrawing `allow_fragment`
      beside `allow_relative` leaves an absolute-URI (§4.3).
      """
    uri_type => unicode.text_type & atom.specification & {
      spec?:           = "https://www.rfc-editor.org/rfc/rfc3986"
      schemes?:        net.scheme_set
      allow_relative?: boolean ~ true
      allow_fragment?: boolean ~ true
      normalization?:  = NONE
    }

    @doc:"""
      The constructor of `uuid` (RFC 9562). `version` admits one UUID version:
      `!uuid ^ { version: 4 }`.
      """
    uuid_type => meta.atom & atom.specification & {
      spec?:    = "https://www.rfc-editor.org/rfc/rfc9562"
      version?: numeric.count
    }
  }

  @doc:"An email address (RFC 5322)."
  @atom.ordering:NONE @atom.bounded:false
  email => !net.email_type {}

  @doc:"An IPv4 address, `192.0.2.1`."
  @atom.ordering:TOTAL @atom.bounded:true
  ipv4 => !net.ipv4_type {}

  @doc:"An IPv6 address (RFC 4291 §2.2), with no zone identifier."
  @atom.ordering:TOTAL @atom.bounded:true
  ipv6 => !net.ipv6_type {}

  @doc:"An IPv4 network, an address and a prefix length: `10.0.0.0/8`."
  @atom.ordering:PARTIAL @atom.bounded:false
  cidr4 => !net.cidr4_type {}

  @doc:"An IPv6 network, an address and a prefix length."
  @atom.ordering:PARTIAL @atom.bounded:false
  cidr6 => !net.cidr6_type {}

  @doc:"A MAC address (EUI-48)."
  @atom.ordering:NONE @atom.bounded:false
  mac => !net.mac_type {}

  @doc:"""
    An Internet host name. `Example.COM` and `example.com` are one value, and so
    are `xn--bcher-kva.example` and `bücher.example`.
    """
  @atom.ordering:NONE @atom.bounded:false
  hostname => !net.hostname_type {}

  @doc:"A host: a `hostname`, an IPv4 address or an IPv6 address."
  @atom.ordering:NONE @atom.bounded:false
  host => !net.host_type {}

  @doc:"A media type without parameters: `text/html`, `application/ld+json`."
  @atom.ordering:NONE @atom.bounded:false
  media_type => !net.media_type_type {}

  @doc:"A URI-reference (RFC 3986 §4.1): a URI or a relative reference."
  @atom.ordering:NONE @atom.bounded:false
  uri_reference => !net.uri_type {}

  @doc:"A URI (RFC 3986 §3): the scheme is required."
  @atom.ordering:NONE @atom.bounded:false
  uri => !uri_reference ^ { allow_relative: false }

  @doc:"A UUID (RFC 9562)."
  @atom.ordering:NONE @atom.bounded:false
  uuid => !net.uuid_type {}
}
