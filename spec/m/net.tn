!!id:"https://tson.io/2026/39/m/net.tn?sha256=b78221075ed3dbb9411d3d90a39d09f759d98a08dba15f5252dc333cb70d0322"
!!import:"https://tson.io/2026/39/m/meta.tn?sha256=0335e318a8ea9b3a9e108ac6b0ef6cf930def8353ce3cafbb241d4c037cacd54"
@meta.doc:"""
  TSON Network Type Library — addresses, networks and host names
  (2026 Revision 39 draft).

  A library a schema imports when it wants these names, and only then: every
  name a schema imports is one it may not declare ([TSON-SCHEMA] §2.2.3). The
  constructors sit under one entry, `net`, so a schema importing this document
  reserves `net` and the instance names at its root; the instances are empty,
  as core's atoms are. The schemaless annotations of the same names
  ([TSON-DATA] §5.5) denote these types.

  Hash pins here are real digests over the bytes of this copy; see
  meta.tn's note.

  References:
    RFC 1123              Host name syntax (§2.1)
    RFC 3492              Punycode
    RFC 3986              IPv4address grammar
    RFC 3987              Internationalized Resource Identifiers (ihost)
    RFC 4291              IPv6 addressing architecture
    RFC 4632              Classless Inter-domain Routing (CIDR)
    RFC 5890-5893         IDNA2008: definitions, protocol, code points, Bidi
    RFC 5952              IPv6 address text representation
    RFC 6838, RFC 6839    Media type specifications, structured suffixes
    RFC 9110 §8.3.1       Media type parameters
    RFC 9542              IEEE 802 parameters (EUI-48 format)
  """
!schema {
  @meta.doc:"The network constructors, each named by its path, `net.ipv4_type`."
  net => !schema {
    @meta.doc:"""
      IPv4 address constraint vocabulary. Instance is `ipv4`. The spec pin cites
      RFC 3986 for its `IPv4address` production — the normative dotted-quad
      grammar ([TSON-DATA] §5.5). `within` and `excluding` list IPv4 networks in
      CIDR text (quoted — the form contains `/`): the address must lie inside at
      least one `within` network when the field is present, and inside no
      `excluding` network. `excluding` carves holes out of `within`.
      """
    ipv4_type => meta.atom & meta.atom_specification & {
      spec?:      = "https://www.rfc-editor.org/rfc/rfc3986"
      within?:    [meta.value]
      excluding?: [meta.value]
    }

    @meta.doc:"""
      IPv6 address constraint vocabulary. Instance is `ipv6`. `within` and
      `excluding` list IPv6 networks in CIDR text (quoted): the address must lie
      inside at least one `within` network when the field is present, and inside
      no `excluding` network.
      """
    ipv6_type => meta.atom & meta.atom_specification & {
      spec?:      = "https://www.rfc-editor.org/rfc/rfc4291"
      within?:    [meta.value]
      excluding?: [meta.value]
    }

    @meta.doc:"""
      IPv4 network constraint vocabulary. Instance is `cidr4`.
      `min_prefix`/`max_prefix` narrow the prefix length within the family range
      0-32; bounds outside that range are invalid at the schema level. `within`
      lists IPv4 networks in CIDR text (quoted): the value must be a subnet of
      at least one. `excluding`: the value must not overlap any listed network —
      overlap, not containment.
      """
    cidr4_type => meta.atom & meta.atom_specification & {
      spec?:       = "https://www.rfc-editor.org/rfc/rfc4632"
      min_prefix?: meta.non_negative_integer
      max_prefix?: meta.non_negative_integer
      within?:     [meta.value]
      excluding?:  [meta.value]
    }

    @meta.doc:"""
      IPv6 network constraint vocabulary. Instance is `cidr6`.
      `min_prefix`/`max_prefix` narrow the prefix length within the family range
      0-128. `within` and `excluding` list IPv6 networks in CIDR text (quoted),
      with the semantics of `cidr4_type`: subnet-of for `within`, non-overlap
      for `excluding`.
      """
    cidr6_type => meta.atom & meta.atom_specification & {
      spec?:       = "https://www.rfc-editor.org/rfc/rfc4291"
      min_prefix?: meta.non_negative_integer
      max_prefix?: meta.non_negative_integer
      within?:     [meta.value]
      excluding?:  [meta.value]
    }

    @meta.doc:"MAC address (EUI-48) constraint vocabulary. Instance is `mac`."
    mac_type => meta.atom & meta.atom_specification & {
      spec?: = "https://www.rfc-editor.org/rfc/rfc9542"
    }

    @meta.doc:"""
      Host name constraint vocabulary. Instance is `hostname`. A domain name as
      a host names it: labels of ASCII letters, digits and hyphens (RFC 1123
      §2.1), or internationalized labels judged by IDNA2008 (RFC 5890 to RFC
      5893), written as U-labels or as their A-labels, in any mix. `A`-`Z` read
      as `a`-`z`; nothing else is mapped, so uppercase beyond ASCII, a U-label
      not in NFC and percent-encoding are not host names. A label is at most 63
      octets and the name at most 253, counted in the A-label form; no label is
      empty, none begins or ends with `-`, and there is no trailing `.`. The
      last label does not begin with a digit, so a dotted-quad is never a host
      name. The value is the name: every spelling of one name is one value, and
      its canonical text has each internationalized label as its U-label.
      `allow_idn` false admits only names with no internationalized label, in
      either spelling.
      """
    hostname_type => meta.atom & meta.atom_specification & {
      spec?:      = "https://www.rfc-editor.org/rfc/rfc5890"
      allow_idn?: meta.boolean ~ true
    }

    @meta.doc:"""
      Host constraint vocabulary. Instance is `host`. RFC 3987's `ihost`
      with a DNS name: a host name as `hostname_type` has it, an IPv4 address in
      dotted-quad, or an IPv6 address, written with or without the brackets a
      URI puts around one. No zone identifier. The value is the name or the
      address, never both; a name compares by name, an address by its octets,
      and an IPv4 address never equals an IPv6 one, IPv4-mapped included. The
      canonical text is the member's: the name's U-labels, the dotted-quad, or
      RFC 5952 text without brackets.
      """
    host_type => meta.atom & meta.atom_specification & {
      spec?: = "https://www.rfc-editor.org/rfc/rfc3987"
    }

    @meta.doc:"""
      Media type constraint vocabulary. Instance is `media_type`. A media
      type (RFC 6838) and its parameters (RFC 9110 §8.3.1): the type and subtype
      are RFC 6838 §4.2's `restricted-name`, and each parameter is a token name,
      `=` and a token or quoted-string value, after a `;` with optional
      whitespace around it. Nothing beyond US-ASCII. A media range (`text/*`) is
      not a media type. The value is the type, the subtype and a map of
      parameters: the type, subtype and parameter names compare without ASCII
      case, a quoted value equals its token form, parameter order carries no
      meaning and a repeated name is a resolver error, and a parameter value
      keeps its case except `charset`'s, which folds. The canonical text is
      lowercase, with `charset` folded and parameters sorted by name, each value
      a token where it is one, joined by `;` without whitespace.
      `allow_parameters` admits parameters, false by default. `types` lists the
      top-level types admitted. `suffixes` lists RFC 6839 structured suffixes: a
      suffix admits a subtype ending `+` and the suffix, and the subtype that is
      the suffix itself. A refinement withdraws `allow_parameters` and shrinks
      `types` and `suffixes`; it never widens them.
      """
    media_type_type => meta.atom & meta.atom_specification & {
      spec?:             = "https://www.rfc-editor.org/rfc/rfc6838"
      allow_parameters?: meta.boolean ~ false
      types?:            [meta.text]
      suffixes?:         [meta.text]
    }
  }

  @meta.doc:"""
    IPv4 address, dotted-quad per the RFC 3986 IPv4address production. Totally
    ordered by numeric address value over a finite 32-bit space.
    """
  @meta.ordering:TOTAL @meta.bounded:true
  ipv4 => !net.ipv4_type {}

  @meta.doc:"""
    IPv6 address, RFC 4291 §2.2 text representation. Zone identifiers (RFC 4007,
    `fe80::1%eth0`) are host-local and excluded from the contract. Totally
    ordered by numeric address value over a finite 128-bit space. (TSON text:
    contains colons, so quote it.)
    """
  @meta.ordering:TOTAL @meta.bounded:true
  ipv6 => !net.ipv6_type {}

  @meta.doc:"""
    IPv4 network, address `/` prefix length 0-32 (RFC 4632). PARTIAL ordering is
    by containment: a network precedes another when its address range is a
    strict subset; CIDR blocks never partially overlap, so any two are nested or
    disjoint, and disjoint networks are incomparable. (TSON text: contains `/`,
    so quote it.)
    """
  @meta.ordering:PARTIAL @meta.bounded:false
  cidr4 => !net.cidr4_type {}

  @meta.doc:"""
    IPv6 network, address `/` prefix length 0-128 (RFC 4291 §2.3). PARTIAL
    ordering is by containment, as for cidr4. (TSON text: contains colons and
    `/`, so quote it.)
    """
  @meta.ordering:PARTIAL @meta.bounded:false
  cidr6 => !net.cidr6_type {}

  @meta.doc:"""
    MAC address, EUI-48: six hex octets, colon- or hyphen-separated (RFC 9542).
    An opaque hardware identifier — like uuid, ordering is not semantically
    meaningful. (TSON text: the colon form must be quoted; the hyphen form may
    go unquoted.)
    """
  @meta.ordering:NONE @meta.bounded:false
  mac => !net.mac_type {}

  @meta.doc:"""
    Internet host name, in either label form: `Example.COM` and `example.com`
    are one value, and so are `xn--bcher-kva.example` and `bücher.example`,
    whose canonical text is the second. See `net.hostname_type`.
    """
  @meta.ordering:NONE @meta.bounded:false
  hostname => !net.hostname_type {}

  @meta.doc:"""
    A host: a `hostname`, an IPv4 address or an IPv6 address, one string-class
    type, so `localhost`, `"127.0.0.1"`, `"::1"` and `"[::1]"` need no tag. See
    `net.host_type`.
    """
  @meta.ordering:NONE @meta.bounded:false
  host => !net.host_type {}

  @meta.doc:"""
    A media type without parameters: `text/html`, `application/ld+json`. See
    `net.media_type_type`.
    """
  @meta.ordering:NONE @meta.bounded:false
  media_type => !net.media_type_type {}
}
