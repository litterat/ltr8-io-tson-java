!!id:"https://tson.io/2026/37/m/core-resolved.tn"
!!schema:"https://tson.io/2026/37/m/meta.tn"
@doc:"""
  Resolver-output fixture for core.tn (2026 Revision 37 draft).
  Parse the source schema, run the resolver, canonicalise, compare.
  Conventions as in meta-kernel-resolved.tn.

  This document is governed by the meta-schema: the structural
  vocabulary (`type_definition`, `record`, `enum`, ...) reaches it
  through meta's kernel import. As a data document, this header
  cannot carry `!!import`: the namespace in which this map's
  type-name tokens resolve (core.tn's locals; core imports nothing)
  is declared by the source schema's header and supplied at ingest
  ([TSON-SCHEMA] Section 8.1), never by this document. The
  annotation types used here
  (`doc` from the kernel via that import; `ordered`, `bounded`,
  `exact`, `numeric` from meta itself) resolve one hop against meta's
  namespace. Constructor names in `source` fields and bodies
  (`integer_type`, `decimal_type`, `float_type`, `complex_type`, ...)
  likewise name meta- and kernel-level entries.

  The open entries (`extern_of`, `extern_type`, `set`) hold their
  bodies — the application as written, unread until materialisation
  substitutes the parameters away — so a token in one is a parameter
  reference rather than a value of the slot's declared type (Section
  8.1's shadowing rule). A processor comparing these compares wire
  form, not bound values.
  """
!schema {
  void => !type_definition {
    source: void_type
    body: !void_type {}
  }

  boolean => !type_definition {
    source: enum
    body: !enum { members: [true false] }
  }

  @ordered:TOTAL @bounded:false @exact:true @numeric
  integer => !type_definition {
    source: integer_type
    subtypes: [int128 int16 int256 int32 int64 int8 negative_integer non_negative_integer non_positive_integer positive_integer uint128 uint16 uint256 uint32 uint64 uint8]
    body: !integer_type {}
  }

  @ordered:TOTAL @bounded:false @exact:true @numeric
  number => !type_definition {
    source: decimal_type
    body: !decimal_type {}
  }

  @ordered:TOTAL @bounded:false @exact:true @numeric
  rational => !type_definition {
    source: rational_type
    body: !rational_type {}
  }

  @ordered:NONE @bounded:false @numeric
  complex => !type_definition {
    source: complex_type
    body: !complex_type {}
  }

  @ordered:TOTAL @bounded:true @exact:true @numeric
  int8 => !type_definition {
    source: integer_type
    supertypes: [integer]
    body: !integer_type { size: { bits: 8  signed: true } }
  }

  @ordered:TOTAL @bounded:true @exact:true @numeric
  int16 => !type_definition {
    source: integer_type
    supertypes: [integer]
    body: !integer_type { size: { bits: 16  signed: true } }
  }

  @ordered:TOTAL @bounded:true @exact:true @numeric
  int32 => !type_definition {
    source: integer_type
    supertypes: [integer]
    body: !integer_type { size: { bits: 32  signed: true } }
  }

  @ordered:TOTAL @bounded:true @exact:true @numeric
  int64 => !type_definition {
    source: integer_type
    supertypes: [integer]
    body: !integer_type { size: { bits: 64  signed: true } }
  }

  @ordered:TOTAL @bounded:true @exact:true @numeric
  int128 => !type_definition {
    source: integer_type
    supertypes: [integer]
    body: !integer_type { size: { bits: 128  signed: true } }
  }

  @ordered:TOTAL @bounded:true @exact:true @numeric
  int256 => !type_definition {
    source: integer_type
    supertypes: [integer]
    body: !integer_type { size: { bits: 256  signed: true } }
  }

  @ordered:TOTAL @bounded:true @exact:true @numeric
  uint8 => !type_definition {
    source: integer_type
    supertypes: [integer]
    body: !integer_type { size: { bits: 8  signed: false } }
  }

  @ordered:TOTAL @bounded:true @exact:true @numeric
  uint16 => !type_definition {
    source: integer_type
    supertypes: [integer]
    body: !integer_type { size: { bits: 16  signed: false } }
  }

  @ordered:TOTAL @bounded:true @exact:true @numeric
  uint32 => !type_definition {
    source: integer_type
    supertypes: [integer]
    body: !integer_type { size: { bits: 32  signed: false } }
  }

  @ordered:TOTAL @bounded:true @exact:true @numeric
  uint64 => !type_definition {
    source: integer_type
    supertypes: [integer]
    body: !integer_type { size: { bits: 64  signed: false } }
  }

  @ordered:TOTAL @bounded:true @exact:true @numeric
  uint128 => !type_definition {
    source: integer_type
    supertypes: [integer]
    body: !integer_type { size: { bits: 128  signed: false } }
  }

  @ordered:TOTAL @bounded:true @exact:true @numeric
  uint256 => !type_definition {
    source: integer_type
    supertypes: [integer]
    body: !integer_type { size: { bits: 256  signed: false } }
  }

  @ordered:TOTAL @bounded:false @exact:true @numeric
  positive_integer => !type_definition {
    source: integer_type
    supertypes: [integer]
    body: !integer_type { min: 1 }
  }

  @ordered:TOTAL @bounded:false @exact:true @numeric
  non_negative_integer => !type_definition {
    source: integer_type
    supertypes: [integer]
    body: !integer_type { min: 0 }
  }

  @ordered:TOTAL @bounded:false @exact:true @numeric
  negative_integer => !type_definition {
    source: integer_type
    supertypes: [integer]
    body: !integer_type { max: -1 }
  }

  @ordered:TOTAL @bounded:false @exact:true @numeric
  non_positive_integer => !type_definition {
    source: integer_type
    supertypes: [integer]
    body: !integer_type { max: 0 }
  }

  @ordered:PARTIAL @bounded:false @exact:false @numeric
  float32 => !type_definition {
    source: float_type
    body: !float_type { format: BINARY32 }
  }

  @ordered:PARTIAL @bounded:false @exact:false @numeric
  float64 => !type_definition {
    source: float_type
    body: !float_type { format: BINARY64 }
  }

  @ordered:NONE @bounded:false
  text => !type_definition {
    source: text_type
    subtypes: [non_empty_text]
    body: !text_type {}
  }

  non_empty_text => !type_definition {
    source: text_type
    supertypes: [text]
    body: !text_type { min_length: 1 }
  }

  @ordered:NONE @bounded:false
  identifier => !type_definition {
    source: identifier_type
    body: !identifier_type { continue_add: "-" }
  }

  @ordered:NONE @bounded:false
  regex => !type_definition {
    source: regex_type
    body: !regex_type {}
  }

  @ordered:NONE @bounded:false
  uri => !type_definition {
    source: uri_type
    body: !uri_type {}
  }

  @ordered:NONE @bounded:false
  bytes => !type_definition {
    source: bytes_type
    body: !bytes_type { encoding: BASE64 }
  }

  @ordered:TOTAL @bounded:true
  date => !type_definition {
    source: date_type
    body: !date_type {}
  }

  @ordered:TOTAL @bounded:true
  time => !type_definition {
    source: time_type
    body: !time_type {}
  }

  @ordered:TOTAL @bounded:true
  datetime => !type_definition {
    source: datetime_type
    body: !datetime_type {}
  }

  @ordered:TOTAL @bounded:true
  duration => !type_definition {
    source: duration_type
    body: !duration_type {}
  }

  @ordered:TOTAL @bounded:false
  period => !type_definition {
    source: period_type
    body: !period_type {}
  }

  @ordered:NONE @bounded:true
  uuid => !type_definition {
    source: uuid_type
    body: !uuid_type {}
  }

  @ordered:NONE @bounded:false
  email => !type_definition {
    source: email_type
    body: !email_type {}
  }

  @ordered:TOTAL @bounded:true
  ipv4 => !type_definition {
    source: ipv4_type
    body: !ipv4_type {}
  }

  @ordered:TOTAL @bounded:true
  ipv6 => !type_definition {
    source: ipv6_type
    body: !ipv6_type {}
  }

  @ordered:PARTIAL @bounded:true
  cidr4 => !type_definition {
    source: cidr4_type
    body: !cidr4_type {}
  }

  @ordered:PARTIAL @bounded:true
  cidr6 => !type_definition {
    source: cidr6_type
    body: !cidr6_type {}
  }

  @ordered:NONE @bounded:true
  mac => !type_definition {
    source: mac_type
    body: !mac_type {}
  }

  @ordered:NONE @bounded:false
  declared => !type_definition {
    source: scoped
    body: !scoped { scope: [LOCAL] }
  }

  @ordered:NONE @bounded:false
  extern => !type_definition {
    source: scoped
    body: !scoped { scope: [EXTERN] }
  }

  @ordered:NONE @bounded:false
  dynamic => !type_definition {
    source: scoped
    body: !scoped { scope: [LOCAL EXTERN] }
  }

  extern_of => !type_definition {
    source: scoped
    body: !template { parameters: [{ name: S  type: uri }]  template: "!scoped { scope: [EXTERN]  schemas: { S => _ } }" }
  }

  extern_type => !type_definition {
    source: scoped
    body: !template { parameters: [{ name: S  type: uri } { name: T  type: type_name }]  template: "!scoped { scope: [EXTERN]  schemas: { S => [T] } }" }
  }

  set => !type_definition {
    source: set_type
    body: !template { parameters: [{ name: T  type: type_ref }]  template: "!set_type { element_type: T }" }
  }

  annotation => @annotation !type_definition {
    source: void
    body: !reference { target: void }
  }

  documentation => @annotation !type_definition {
    source: text
    body: !reference { target: text }
  }

  doc => @annotation !type_definition {
    source: documentation
    body: !reference { target: documentation }
  }
}
