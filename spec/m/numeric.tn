!!id:"https://tson.io/2026/40/m/numeric.tn?sha256=44b6423f588662106c5cc68f398e3ea2f0734196e80defb928a4b218d4cb83a8"
!!import:"https://tson.io/2026/40/m/meta.tn?sha256=fba10509f9c9db688ee01d2921635a24b1879d80b19f43c59edba3674c18252d"
@doc:"""
  The TSON numeric library: the exact `number` and `rational`, `complex`, the
  sized integers `int8` to `uint256` and the IEEE 754 `float32` and `float64`. A
  schema imports it, or core.tn, to write them ([TSON-DATA] §5.6, [TSON-SCHEMA]
  §5.5).

  Shared by every family here and in temporal.tn: a lower bound does not exceed
  the upper; `multiple_of` is strictly positive and tests the value's magnitude;
  every member satisfies the other facets on the same body.
  """
!schema {
  @doc:"""
    The numeric constructors and their facet vocabulary, each named by its path,
    `numeric.decimal_type`.
    """
  numeric => !schema {
    @doc:"""
      IEEE 754-2019 interchange formats. The decimal formats are base-10
      floating point, approximate, and are not `decimal_type`'s exact decimals.
      """
    ieee_format => !enum [
      BINARY16 BINARY32 BINARY64 BINARY128 BINARY256
      DECIMAL32 DECIMAL64 DECIMAL128
    ]

    @doc:"""
      The constructor of `float32` and `float64`. An approximate value: the
      receiver rounds it onto the IEEE 754-2019 grid `format` names, to nearest,
      ties to even. The value set is that grid with signed zeros, subnormals,
      the two infinities and the canonical quiet NaN ([TSON-DATA] §5.6), and the
      `allow_` facets exclude those.

      A bound is an exact `number`, judged against the value as written, before
      rounding: it orders the infinities and admits no NaN, so `allow_nan`
      decides NaN only where no bound is written ([TSON-SCHEMA] §5.5).
      """
    float_type => meta.atom & atom.specification & {
      spec?:                = "https://ieeexplore.ieee.org/document/8766229"
      format:               numeric.ieee_format
      ( min: number | exclusive_min: number )?
      ( max: number | exclusive_max: number )?
      allow_nan?:           boolean ~ true
      allow_infinity?:      boolean ~ true
      allow_subnormal?:     boolean ~ true
      allow_negative_zero?: boolean ~ true
    }

    @doc:"The members of a decimal_type."
    decimal_member_set => !meta.set_type { element_type: number  min_items: 1 }

    @doc:"""
      The constructor of `number`. An author refines the instance:
      `price => !number ^ { min: 0  fraction_digits: 2 }`. Exact: nothing is
      rounded, and scale is no part of the value, so `1`, `1.0` and `1.00` are
      one value. `total_digits` counts significant digits and `fraction_digits`
      digits after the point ([TSON-SCHEMA] §5.5).
      """
    decimal_type => meta.atom & {
      ( min: number | exclusive_min: number )?
      ( max: number | exclusive_max: number )?
      multiple_of?:     number
      total_digits?:    numeric.count
      fraction_digits?: numeric.count
      members?:         numeric.decimal_member_set
    }

    @doc:"""
      The constructor of `rational`. The value is the fraction: `2/4` and `1/2`
      are one value. The denominator is positive.
      """
    rational_type => meta.atom & {
      ( min: rational | exclusive_min: rational )?
      ( max: rational | exclusive_max: rational )?
      multiple_of?: rational
    }

    @doc:"""
      The type of a complex value's parts. A refinement moves `component` only
      to a member whose value set is inside the source's: INTEGER ⊂ NUMBER ⊂
      RATIONAL and FLOAT32 ⊂ FLOAT64, the two families incomparable.
      """
    complex_component => !enum [INTEGER NUMBER RATIONAL FLOAT32 FLOAT64]

    @doc:"""
      The constructor of `complex`: a pair of components, the real and imaginary
      parts, both of the type `component` names.
      """
    complex_type => meta.atom & {
      component?: numeric.complex_component ~ NUMBER
    }
  }

  @doc:"""
    An exact decimal number of any magnitude and precision, with no infinities
    and no NaN. Refine it to constrain it:
    `price => !number ^ { min: 0  fraction_digits: 2 }`.
    """
  @atom.ordering:TOTAL @atom.bounded:false @atom.exact:true @atom.numeric
  number => !numeric.decimal_type {}

  @doc:"An exact fraction of two integers."
  @atom.ordering:TOTAL @atom.bounded:false @atom.exact:true @atom.numeric
  rational => !numeric.rational_type {}

  @doc:"A complex number: a real and an imaginary part, each an exact `number`."
  @atom.ordering:NONE @atom.bounded:false @atom.numeric
  complex => !numeric.complex_type {}

  @doc:"Signed 8-bit integer (-128 to 127)."
  @atom.ordering:TOTAL @atom.bounded:true @atom.exact:true @atom.numeric
  int8 => !integer ^ { size: { bits: 8  signed: true } }

  @doc:"Signed 16-bit integer."
  @atom.ordering:TOTAL @atom.bounded:true @atom.exact:true @atom.numeric
  int16 => !integer ^ { size: { bits: 16  signed: true } }

  @doc:"Signed 32-bit integer."
  @atom.ordering:TOTAL @atom.bounded:true @atom.exact:true @atom.numeric
  int32 => !integer ^ { size: { bits: 32  signed: true } }

  @doc:"Signed 128-bit integer."
  @atom.ordering:TOTAL @atom.bounded:true @atom.exact:true @atom.numeric
  int128 => !integer ^ { size: { bits: 128  signed: true } }

  @doc:"Signed 256-bit integer."
  @atom.ordering:TOTAL @atom.bounded:true @atom.exact:true @atom.numeric
  int256 => !integer ^ { size: { bits: 256  signed: true } }

  @doc:"Unsigned 8-bit integer (0 to 255)."
  @atom.ordering:TOTAL @atom.bounded:true @atom.exact:true @atom.numeric
  uint8 => !integer ^ { size: { bits: 8  signed: false } }

  @doc:"Unsigned 16-bit integer."
  @atom.ordering:TOTAL @atom.bounded:true @atom.exact:true @atom.numeric
  uint16 => !integer ^ { size: { bits: 16  signed: false } }

  @doc:"Unsigned 32-bit integer."
  @atom.ordering:TOTAL @atom.bounded:true @atom.exact:true @atom.numeric
  uint32 => !integer ^ { size: { bits: 32  signed: false } }

  @doc:"Unsigned 64-bit integer."
  @atom.ordering:TOTAL @atom.bounded:true @atom.exact:true @atom.numeric
  uint64 => !integer ^ { size: { bits: 64  signed: false } }

  @doc:"Unsigned 128-bit integer."
  @atom.ordering:TOTAL @atom.bounded:true @atom.exact:true @atom.numeric
  uint128 => !integer ^ { size: { bits: 128  signed: false } }

  @doc:"Unsigned 256-bit integer."
  @atom.ordering:TOTAL @atom.bounded:true @atom.exact:true @atom.numeric
  uint256 => !integer ^ { size: { bits: 256  signed: false } }

  @doc:"IEEE 754 binary32: approximate, a value being rounded onto its grid."
  @atom.ordering:PARTIAL @atom.bounded:false @atom.exact:false @atom.numeric
  float32 => !numeric.float_type { format: BINARY32 }

  @doc:"IEEE 754 binary64: approximate, a value being rounded onto its grid."
  @atom.ordering:PARTIAL @atom.bounded:false @atom.exact:false @atom.numeric
  float64 => !numeric.float_type { format: BINARY64 }
}
