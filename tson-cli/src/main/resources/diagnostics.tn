!!id:"https://tson.io/2026/32/ltr8/cli/diagnostics-2.tn"
!!meta:"https://tson.io/2026/32/m/meta.tn"
!!import:"https://tson.io/2026/32/m/core.tn"
@doc:"""
  This project's own schema !!id convention (see CLAUDE.md's "Project-owned schema !!id
  convention"): /2026/32 is the spec revision this schema is written against, ltr8 is the
  publishing org, cli is this module's own schema group, and the trailing -2 is this schema's
  own version -- bumped from -1 once multi-error collection needed path/expected/actual/position
  fields on diagnostic, per that same convention's "bump it, under a new name" rule; never edit a
  published schema's own content in place.
  """
{
  diagnostic_code => !enum [
    FIELD_REQUIRED TYPE_MISMATCH WRONG_ARITY UNKNOWN_TYPE_REF ATOM_CONSTRAINT_VIOLATION
    UNRECOGNIZED_FIELD DUPLICATE_MAP_KEY SCHEMA_ERROR UNKNOWN_TYPE VALIDATION_ERROR
  ]
  diagnostic => {
    path: text
    code: diagnostic_code
    message: text
    expected: text
    actual: text
    data_position: text?
    schema_position: text?
  }
  validation_report => { valid: boolean  errors: [diagnostic] }
}
